# Copy to .env.local and fill in. Never commit real values.

# Backend connection (client-visible, safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side equivalents
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# SECRET — bypasses row-level security. Server only, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — AI gateway key used by receipt scanning.
LOVABLE_API_KEY=
